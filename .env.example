# Environment Variables Template
# Copy this to .env and fill in your actual values

# === Reddit API (Required for Reddit data collection) ===
# Get credentials at: https://www.reddit.com/prefs/apps
# See docs/REDDIT_API_SETUP.md for detailed instructions
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=MemecoinsAnalyzer/1.0

# === Twitter API (Optional - for Twitter data collection) ===
# Get credentials at: https://developer.twitter.com/en/portal/dashboard
# Note: Twitter API is now paid, use only if you have access
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# === Database (Optional - for production deployment) ===
# Local development uses SQLite by default
# For production, use PostgreSQL (Supabase free tier recommended)
# DATABASE_URL=postgresql://user:password@host:port/database

# === API Configuration ===
# Used for rate limiting and monitoring
API_RATE_LIMIT=100
API_RATE_WINDOW=60

# === Data Collection Settings ===
# How many posts to collect per coin per run
MAX_POSTS_PER_COIN=50

# How many trending coins to track
MAX_TRENDING_COINS=50

# === CoinGecko API ===
# No API key required for free tier
# If you have a paid plan, add it here for higher rate limits
# COINGECKO_API_KEY=your_api_key_here
